# Copier en .env : cp .env.example .env

# Base de données (valeurs du lab, cf. espace-de-travail-devs.md)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Nom DNS de la base sur resilience-net
POSTGRES_HOST=

# Clé de signature des tokens JWT : 32 caractères minimum, à générer avec
#   openssl rand -base64 48
# Laissée vide volontairement (ne jamais committer de vraie clé).
# L'API refuse de démarrer tant qu'elle est vide ou trop courte.
JWT_SECRET_KEY=

# Origines autorisées par CORS, séparées par des virgules.
# Vide = aucune : le front appelle l'API via /api sur la même origine, CORS n'est pas nécessaire.
CORS_ORIGINS=

LOG_LEVEL=
