# Copier en .env : cp .env.example .env

# Modèle de génération (doit être tiré dans Ollama) et modèle d'embeddings.
LLM_MODEL=gemma4:e4b
EMBED_MODEL=nomic-embed-text

# Clé exigée dans l'en-tête X-API-Key par toutes les routes sauf /health.
# À générer avec : openssl rand -hex 32  (ne jamais committer la vraie valeur)
ASSISTANT_API_KEY=

# IP sur laquelle publier l'assistant : l'IP Tailscale du PC (tailscale ip -4).
# Vide = 127.0.0.1, accessible depuis le PC seulement.
ASSISTANT_BIND=

# Dossier des documents indexés (relatif à ce fichier). Défaut : ../docs
DOCS_DIR=

LOG_LEVEL=INFO
